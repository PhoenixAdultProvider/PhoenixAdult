// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
// Inlines @docusaurus/tsconfig as of v4 (facebook/docusaurus#11915) so TypeScript 7 works;
// go back to "extends": "@docusaurus/tsconfig" once Docusaurus v4 ships it.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["${configDir}/*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["${configDir}/.docusaurus", "${configDir}/build"]
}
