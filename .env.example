# Every value below matches the built-in default — copying this file changes
# nothing until you edit a line. Blank = derived/disabled default.
# Sections mirror the /config UI tabs.

# ── Server ───────────────────────────────────────────────────────────────────
# User accounts replace ADMIN_TOKEN: visit /setup on first run to create one.
# Plex servers are paired per user from the Plex tab of /config.
PORT=3000
PHOENIX_BASE_URL=http://localhost:3000
NODE_ENV=production

# ── Matching & Title Parsing ─────────────────────────────────────────────────
STRIP_ENABLE=false
STRIP_SYMBOL=
STRIP_SYMBOL_REVERSE=
SEARCH_TITLE_TRASH=
SEARCH_STRIP_ACTORS=
DISABLE_AUTO_MATCH=false

# ── Scraping & Pacing ────────────────────────────────────────────────────────
PHOENIX_EXTRA_COLLECTIONS=false
SCENE_GAP=10
REFRESH_FORCE_COUNT=3
SEARCH_STORE_TTL_DAYS=0

# ── HTTP Bypass ──────────────────────────────────────────────────────────────
FLARESOLVERR_URL=
REQBIN_ENABLE=false
REQBIN_API_KEY=
BYPASS_ORDER=Impersonate,FlareSolverr,Playwright,ReqBin
PLAYWRIGHT_BROWSER=chromium
BYPASS_AUTO_RETRY=false
BYPASS_TIMEOUT_MS=10000
#PLAYWRIGHT_BROWSERS_PATH=
#TMPDIR=

# ── Web Search ───────────────────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── Data18 Enrichment ────────────────────────────────────────────────────────
DATA18_ENABLE=false
DATA18_ACCURACY=100
DATA18_EXTRA=false

# ── MetadataAPI ──────────────────────────────────────────────────────────────
METADATAAPI_TOKEN=

# ── Manual NFO ───────────────────────────────────────────────────────────────
MANUAL_NFO_PATH=./local/manual
MANUAL_NFO_TOKEN=manual

# ── People Cache & Sources ───────────────────────────────────────────────────
PEOPLE_CACHE_ENABLE=true
PEOPLE_CACHE_REPLACE_ENABLE=false
PEOPLE_CACHE_FACE_ENABLE=false
PEOPLE_SOURCE_ORDER=
ADULT_EMPIRE_LOGIN_TOKEN=

# ── Gender Handling ──────────────────────────────────────────────────────────
GENDER_DETECT_ENABLE=true
GENDER_SKIP_MALE_ENABLE=false
GENERIC_IMAGE_ENABLE=true
GENERIC_FEMALE_URL=
GENERIC_MALE_URL=

# ── Images ───────────────────────────────────────────────────────────────────
IMAGE_DIR=./local/images
IMAGE_MAX_BYTES=20M
IMAGE_PROXY_PIN=true

# Serve images only to Plex, loopback, admin-token requests, and the admin UIs.
# A browser typing an image URL directly gets a 403.
IMAGE_GUARD_ENABLE=false
IMAGE_BASE_URL=baseurl

# ── Metadata Cache ───────────────────────────────────────────────────────────
METADATA_CACHE_ENABLE=false
METADATA_CACHE_DIR=./local/cache
STATE_DB_PATH=./local/phoenixadult.db
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_KEEP=7
DB_BACKUP_DIR=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_REDACT_HOSTS=
LOG_REDACT_TOKEN=

# ── Network ──────────────────────────────────────────────────────────────────
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=
