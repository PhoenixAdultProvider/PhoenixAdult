# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
PHOENIX_BASE_URL=http://localhost:3000
NODE_ENV=production

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_REDACT_HOSTS=true
LOG_REDACT_TOKEN=true

# ── Admin auth (guards admin routes) ─────────────────────────────────────────
ADMIN_TOKEN=

# ── Images ───────────────────────────────────────────────────────────────────
IMAGE_DIR=./local/cache/images
IMAGE_MAX_BYTES=20M

# ── Manual NFO ───────────────────────────────────────────────────────────────
MANUAL_NFO_PATH=./local/manual
MANUAL_NFO_TOKEN=manual

# ── Metadata cache ───────────────────────────────────────────────────────────
METADATA_CACHE_ENABLE=true
METADATA_CACHE_DIR=./local/cache/metadata

# ── Actor cache & sources ────────────────────────────────────────────────────
PEOPLE_CACHE_DIR=./local/cache/images/people
PEOPLE_CACHE_ENABLE=false
PEOPLE_CACHE_REPLACE_ENABLE=false
PEOPLE_CACHE_FACE_ENABLE=false
PEOPLE_SOURCE_ORDER=Local Storage,AdultDVDEmpire,Freeones,IAFD,Indexxx,Boobpedia,Babes and Stars,Babepedia
ADULT_EMPIRE_LOGIN_TOKEN=

# ── Gender handling ──────────────────────────────────────────────────────────
GENDER_DETECT_ENABLE=false
GENDER_ENABLE=false
GENERIC_IMAGE_ENABLE=false
GENERIC_FEMALE_URL=
GENERIC_MALE_URL=

# ── Web search ───────────────────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── HTTP bypass ──────────────────────────────────────────────────────────────
FLARESOLVERR_URL=
REQBIN_ENABLE=false
REQBIN_API_KEY=
BYPASS_ORDER=Impersonate,FlareSolverr,Playwright,ReqBin
BYPASS_AUTO_RETRY=false

# ── Data18 enrichment ────────────────────────────────────────────────────────
DATA18_ENABLE=false
DATA18_ACCURACY=100
DATA18_EXTRA=false

# ── MetadataAPI ──────────────────────────────────────────────────────────────
METADATAAPI_TOKEN=

# ── Misc ─────────────────────────────────────────────────────────────────────
PHOENIX_EXTRA_COLLECTIONS=false
STRIP_ENABLE=false
STRIP_SYMBOL=
STRIP_SYMBOL_REVERSE=
DISABLE_AUTO_MATCH=false

# ── Network ──────────────────────────────────────────────────────────────────
HTTPS_PROXY=
NO_PROXY=
