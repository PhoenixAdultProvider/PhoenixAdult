# Every value below matches the built-in default — copying this file changes
# nothing until you edit a line. Blank = derived/disabled default.
# No inline comments after values (systemd EnvironmentFile reads them literally).

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
PHOENIX_BASE_URL=http://localhost:3000
NODE_ENV=production

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_REDACT_HOSTS=
LOG_REDACT_TOKEN=

# ── Admin auth (guards admin routes) ─────────────────────────────────────────
ADMIN_TOKEN=

# ── Images ───────────────────────────────────────────────────────────────────
IMAGE_DIR=./local/images
IMAGE_MAX_BYTES=20M
IMAGE_PROXY_PIN=true
LOGO_CACHE_ENABLE=false
LOGO_CACHE_DIR= # defaults to IMAGE_DIR/logos

# ── Manual NFO ───────────────────────────────────────────────────────────────
MANUAL_NFO_PATH=./local/manual
MANUAL_NFO_TOKEN=manual

# ── Metadata cache ───────────────────────────────────────────────────────────
METADATA_CACHE_ENABLE=false
METADATA_CACHE_DIR=./local/cache

# ── Actor cache & sources ────────────────────────────────────────────────────
PEOPLE_CACHE_DIR=./local/images/people
PEOPLE_CACHE_ENABLE=true
PEOPLE_CACHE_REPLACE_ENABLE=false
PEOPLE_CACHE_FACE_ENABLE=false
PEOPLE_SOURCE_ORDER= # Local Storage,Scene,AdultDVDEmpire,Freeones,IAFD,Indexxx,Boobpedia,Babes and Stars,Babepedia
PEOPLE_IMAGE_URL=baseurl # baseurl | localhost | localipv4 | localipv6 | explicit address (192.0.2.10; scheme/PORT filled in if omitted)
ADULT_EMPIRE_LOGIN_TOKEN=

# ── Gender handling ──────────────────────────────────────────────────────────
GENDER_DETECT_ENABLE=true
GENDER_SKIP_MALE_ENABLE=false
GENERIC_IMAGE_ENABLE=true
GENERIC_FEMALE_URL=
GENERIC_MALE_URL=

# ── Web search ───────────────────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── HTTP bypass ──────────────────────────────────────────────────────────────
FLARESOLVERR_URL=
REQBIN_ENABLE=false
REQBIN_API_KEY=
BYPASS_ORDER=Impersonate,FlareSolverr,Playwright,ReqBin
BYPASS_AUTO_RETRY=false
BYPASS_TIMEOUT_MS=10000
PLAYWRIGHT_BROWSER=chromium # chromium | firefox | webkit.
#PLAYWRIGHT_BROWSERS_PATH=
#TMPDIR=

# ── Data18 enrichment ────────────────────────────────────────────────────────
DATA18_ENABLE=false
DATA18_ACCURACY=100
DATA18_EXTRA=false

# ── MetadataAPI ──────────────────────────────────────────────────────────────
METADATAAPI_TOKEN=

# ── Plex server (only needed for POST /plex/reconcile) ──────────────────────
PLEX_URL=
PLEX_TOKEN=
PLEX_CLIENT_ID=

# ── Misc ─────────────────────────────────────────────────────────────────────
PHOENIX_EXTRA_COLLECTIONS=false
STRIP_ENABLE=false
STRIP_SYMBOL=
STRIP_SYMBOL_REVERSE=
DISABLE_AUTO_MATCH=false
SEARCH_TITLE_TRASH=
SEARCH_STRIP_ACTORS=
SCENE_GAP=10
SEARCH_QUEUE_DIR=./local/queue

# ── Network ──────────────────────────────────────────────────────────────────
HTTPS_PROXY=
HTTP_PROXY=
