# Every value below matches the built-in default — copying this file changes
# nothing until you edit a line. Blank = derived/disabled default.
# No inline comments after values (systemd EnvironmentFile reads them literally).

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
PHOENIX_BASE_URL=http://localhost:3000
NODE_ENV=production

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
# Blank = follow NODE_ENV: redacted in production, visible in development.
LOG_REDACT_HOSTS=
LOG_REDACT_TOKEN=

# ── Admin auth (guards admin routes) ─────────────────────────────────────────
ADMIN_TOKEN=

# ── Images ───────────────────────────────────────────────────────────────────
IMAGE_DIR=./local/images
IMAGE_MAX_BYTES=20M

# ── Manual NFO ───────────────────────────────────────────────────────────────
MANUAL_NFO_PATH=./local/manual
MANUAL_NFO_TOKEN=manual

# ── Metadata cache ───────────────────────────────────────────────────────────
METADATA_CACHE_ENABLE=false
METADATA_CACHE_DIR=./local/cache

# ── Actor cache & sources ────────────────────────────────────────────────────
PEOPLE_CACHE_DIR=./local/images/people
PEOPLE_CACHE_ENABLE=true
PEOPLE_CACHE_REPLACE_ENABLE=false
PEOPLE_CACHE_FACE_ENABLE=false
# Blank = built-in order with the scene image tried first. To customize, list
# source names; "Scene" = the actor image from the scene page itself:
# Local Storage,Scene,AdultDVDEmpire,Freeones,IAFD,Indexxx,Boobpedia,Babes and Stars,Babepedia
PEOPLE_SOURCE_ORDER=
# baseurl | localhost | localipv4 | localipv6
PEOPLE_IMAGE_URL=baseurl
ADULT_EMPIRE_LOGIN_TOKEN=

# ── Gender handling ──────────────────────────────────────────────────────────
GENDER_DETECT_ENABLE=true
GENDER_SKIP_MALE_ENABLE=false
GENERIC_IMAGE_ENABLE=true
GENERIC_FEMALE_URL=
GENERIC_MALE_URL=

# ── Web search ───────────────────────────────────────────────────────────────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── HTTP bypass ──────────────────────────────────────────────────────────────
FLARESOLVERR_URL=
REQBIN_ENABLE=false
REQBIN_API_KEY=
BYPASS_ORDER=Impersonate,FlareSolverr,Playwright,ReqBin
BYPASS_AUTO_RETRY=false

# ── Data18 enrichment ────────────────────────────────────────────────────────
DATA18_ENABLE=false
DATA18_ACCURACY=100
DATA18_EXTRA=false

# ── MetadataAPI ──────────────────────────────────────────────────────────────
METADATAAPI_TOKEN=

# ── Misc ─────────────────────────────────────────────────────────────────────
PHOENIX_EXTRA_COLLECTIONS=false
STRIP_ENABLE=false
STRIP_SYMBOL=
STRIP_SYMBOL_REVERSE=
DISABLE_AUTO_MATCH=false
# Extra junk tokens stripped from parsed titles, appended to the built-in list.
SEARCH_TITLE_TRASH=

# ── Network ──────────────────────────────────────────────────────────────────
HTTPS_PROXY=
NO_PROXY=
