msgid "settings.token_based_auth.label"
msgstr "Require an API Key in the Provider URL"
msgid "settings.token_based_auth.description"
msgstr "When on, the provider mount answers only through its hook path. Register it in Plex as http://host:port/api/hook/YOUR_KEY/phoenixadult/movies. Generate keys on the Account page."
msgid "settings.client_token_required.label"
msgstr "Require a Registered Plex Client"
msgid "settings.client_token_required.description"
msgstr "When on, match and metadata requests must carry an X-Plex-Client-Identifier listed under a Plex connection. The provider URL itself always answers, so Plex can add the provider at any time."
msgid "settings.api_requests_per_day.label"
msgstr "Daily Provider Request Limit"
msgid "settings.api_requests_per_day.description"
msgstr "Requests each Plex client and each API key may make to the provider per day. 0 means unlimited. Over the limit the provider answers 429 until midnight."
msgid "settings.ui_language.label"
msgstr "Language"
msgid "settings.ui_language.description"
msgstr "Language of the web pages. English is the only translation so far."
msgid "settings.log_level.label"
msgstr "Log Level"
msgid "settings.log_level.description"
msgstr "Log Verbosity, least to most. HTTP access lines need http or verbose; scraped response bodies need verbose, the last step — http is not enough."
msgid "settings.http_body_dump.label"
msgstr "Dump Scraped Page Sources"
msgid "settings.http_body_dump.description"
msgstr "Write the raw body of every page the scrapers fetch to a file under the log directory, whatever the log level. Turn this on to inspect the html a selector actually saw; turn it off when you are done."
msgid "settings.log_body_max_chars.label"
msgstr "Verbose Body Dump Limit"
msgid "settings.log_body_max_chars.description"
msgstr "Characters of each scraped response body written to the log at verbose level. 0 keeps the whole body. Only applies while Log Level is verbose; JSON bodies are pretty-printed first."
msgid "settings.log_redact_hosts.label"
msgstr "Redact Hosts and IPs in Logs"
msgid "settings.log_redact_hosts.description"
msgstr "Mask every IP address and the server’s own host in logs. A development-only switch: production always redacts and this setting disappears there."
msgid "settings.log_redact_token.label"
msgstr "Redact Tokens in Logs"
msgid "settings.log_redact_token.description"
msgstr "Mask credentials in logs: hook-path API keys (/api/hook/…), secret query values (?token=…, ?password=…), and credential headers in request dumps. A development-only switch: production always redacts and this setting disappears there."
msgid "settings.image_dir.label"
msgstr "Local Image Directory"
msgid "settings.image_dir.description"
msgstr "Directory served back to Plex for local people and logo image files (people/ and logos/ subfolders)."
msgid "settings.image_max_bytes.label"
msgstr "Max Image Size"
msgid "settings.image_max_bytes.description"
msgstr "Ceiling on a single upstream image fetch; accepts a byte count or a size like 20M, 2000K or 100B."
msgid "settings.image_proxy_pin.label"
msgstr "Pin Proxy Fetches to the Resolved IP"
msgid "settings.image_proxy_pin.description"
msgstr "SSRF hardening: /images/proxy fetches by pinned, validated-public IP; turn off if a CDN rejects it."
msgid "settings.image_guard_enable.label"
msgstr "Block Direct Image Browsing"
msgid "settings.image_guard_enable.description"
msgstr "Serve images only to signed URLs, Plex, image fetchers, loopback, admin token, and the admin UIs — a typed-in URL gets a 403."
msgid "settings.manual_nfo_path.label"
msgstr "Manual NFO Folder"
msgid "settings.manual_nfo_path.description"
msgstr "Root folder served by the \"Manual NFO\" scraper."
msgid "settings.manual_nfo_token.label"
msgstr "Manual NFO Filename Prefix"
msgid "settings.manual_nfo_token.description"
msgstr "Leading filename token that pins a match to the Manual NFO scraper."
msgid "settings.dev_ui_enable.label"
msgstr "Enable the Dev and Test UI"
msgid "settings.dev_ui_enable.description"
msgstr "Serves the scraper test bench at /dev. Admin-only either way; off means the routes answer 404."
msgid "settings.people_cache_enable.label"
msgstr "Enable People Cache"
msgid "settings.people_cache_enable.description"
msgstr "When off, photo URLs are re-resolved on every scene refresh."
msgid "settings.people_cache_replace_enable.label"
msgstr "Force Re-Fetch Cached Photos"
msgid "settings.people_cache_replace_enable.description"
msgstr "Ignore existing cached photos and re-fetch every time."
msgid "settings.metadata_cache_enable.label"
msgstr "Snapshot Metadata Cache"
msgid "settings.metadata_cache_enable.description"
msgstr "Snapshot each scraped scene’s metadata + images and serve them cache-first; manage at /metadata."
msgid "settings.metadata_cache_dir.label"
msgstr "Metadata Cache Directory"
msgid "settings.metadata_cache_dir.description"
msgstr "On-disk location for metadata snapshots (text + images)."
msgid "settings.people_cache_face_enable.label"
msgstr "Face-Crop Cached Photos"
msgid "settings.people_cache_face_enable.description"
msgstr "Crop cached headshots to head + shoulders (needs opencv-python-headless); review/undo at /people."
msgid "settings.people_source_order.label"
msgstr "People Source Order"
msgid "settings.people_source_order.description"
msgstr "Headshot lookup priority — drag to reorder; \"Scene\" is the scene-page image, IAFD needs the Impersonate bypass."
msgid "settings.image_base_url.label"
msgstr "Local Image Base Address"
msgid "settings.image_base_url.description"
msgstr "Base URL Plex fetches headshots/logos from: baseurl (PHOENIX_BASE_URL), localhost, localipv4, localipv6, or an explicit address like http://192.0.2.10:8080."
msgid "settings.adult_empire_login_token.label"
msgstr "Adult Empire Login Token"
msgid "settings.adult_empire_login_token.description"
msgstr "Session token for the AdultDVDEmpire actor-photo source."
msgid "settings.gender_detect_enable.label"
msgstr "Detect Actor Gender"
msgid "settings.gender_detect_enable.description"
msgstr "Query IAFD for each uncached actor and bake the gender into the cached filename."
msgid "settings.gender_skip_male_enable.label"
msgstr "Drop Male Actors"
msgid "settings.gender_skip_male_enable.description"
msgstr "Hide male actors from the served Plex cast list (applied at serve time, so cached scenes re-filter too)."
msgid "settings.generic_image_enable.label"
msgstr "Generic Placeholder Photos"
msgid "settings.generic_image_enable.description"
msgstr "Use a generic silhouette image when an actor has no resolvable photo."
msgid "settings.generic_female_url.label"
msgstr "Generic Female Photo URL"
msgid "settings.generic_female_url.description"
msgstr "Overrides the built-in female placeholder image."
msgid "settings.generic_male_url.label"
msgstr "Generic Male Photo URL"
msgid "settings.generic_male_url.description"
msgstr "Overrides the built-in male placeholder image."
msgid "settings.google_search_api_key.label"
msgstr "Google CSE API Key"
msgid "settings.google_search_api_key.description"
msgstr "Custom Search API key; with the CX set, Google CSE runs before the DuckDuckGo fallback."
msgid "settings.google_search_cx.label"
msgstr "Google CSE Engine ID"
msgid "settings.google_search_cx.description"
msgstr "Programmable Search Engine ID (CX) paired with the API key above."
msgid "settings.flaresolverr_url.label"
msgstr "FlareSolverr Endpoint"
msgid "settings.flaresolverr_url.description"
msgstr "Self-hosted FlareSolverr URL used to bypass Cloudflare challenges."
msgid "settings.reqbin_enable.label"
msgstr "Enable ReqBin Fallback"
msgid "settings.reqbin_enable.description"
msgstr "Use the third-party ReqBin service as an HTTP-bypass fallback."
msgid "settings.reqbin_api_key.label"
msgstr "ReqBin API Key"
msgid "settings.reqbin_api_key.description"
msgstr "API key for the ReqBin HTTP-bypass fallback."
msgid "settings.bypass_order.label"
msgstr "Bypass Attempt Order"
msgid "settings.bypass_order.description"
msgstr "Order of HTTP-bypass strategies to try. Drag to reorder."
msgid "settings.playwright_browser.label"
msgstr "Playwright Browser Engine"
msgid "settings.playwright_browser.description"
msgstr "Browser the Playwright bypass launches; on FreeBSD/linuxulator, Firefox is the most reliable."
msgid "settings.bypass_auto_retry.label"
msgstr "Auto-Retry Every 4xx/5xx via Bypass"
msgid "settings.bypass_auto_retry.description"
msgstr "Re-route every failed scraper request (4xx/5xx) through the bypass chain."
msgid "settings.bypass_timeout_ms.label"
msgstr "Bypass Solve Timeout (ms)"
msgid "settings.bypass_timeout_ms.description"
msgstr "Per-attempt ceiling for a challenge solve before falling through to the next backend."
msgid "settings.data18_enable.label"
msgstr "Enable Data18 Enrichment"
msgid "settings.data18_enable.description"
msgstr "Master on/off for data18.com image enrichment (per-site opt-in still required)."
msgid "settings.data18_accuracy.label"
msgstr "Data18 Match Accuracy"
msgid "settings.data18_accuracy.description"
msgstr "Minimum match accuracy (0-100); lower = more matches but more false positives."
msgid "settings.data18_extra.label"
msgstr "Data18 Extra Galleries"
msgid "settings.data18_extra.description"
msgstr "Include large/low-quality photoset (1001) and 1901 galleries."
msgid "settings.phoenix_extra_collections.label"
msgstr "Extra Collections"
msgid "settings.phoenix_extra_collections.description"
msgstr "Restore the extra-collections pass (studio / serie / movie titles) in GammaEntOther."
msgid "settings.strip_enable.label"
msgstr "Strip Junk Around the Title"
msgid "settings.strip_enable.description"
msgstr "Enable the two strip-symbol rules below."
msgid "settings.strip_symbol.label"
msgstr "Strip Symbol — Keep Text Before"
msgid "settings.strip_symbol.description"
msgstr "Keep only the text BEFORE this symbol’s first occurrence in the parsed title."
msgid "settings.strip_symbol_reverse.label"
msgstr "Strip Symbol — Keep Text After"
msgid "settings.strip_symbol_reverse.description"
msgstr "Keep only the text AFTER this symbol’s last occurrence in the parsed title."
msgid "settings.search_title_trash.label"
msgstr "Extra Search-Title Junk Tokens"
msgid "settings.search_title_trash.description"
msgstr "Extra whole-word junk tokens stripped from the parsed title, appended to the built-in list."
msgid "settings.scene_gap.label"
msgstr "Paced Scrapers: Between-Scenes Delay"
msgid "settings.scene_gap.description"
msgstr "Base seconds between units of work on rate-limited scrapers (10-45s jitter added on top); deferred work runs at /queue."
msgid "settings.refresh_force_count.label"
msgstr "Refreshes Needed to Force a Refetch"
msgid "settings.refresh_force_count.description"
msgstr "Plex refreshes of one scene within 60 seconds that force a fresh scrape (1 = refetch every refresh)."
msgid "settings.search_store_ttl_days.label"
msgstr "Search Result Lifetime (Days)"
msgid "settings.search_store_ttl_days.description"
msgstr "Days a cached search result stays valid before a later scan re-searches; 0 = never expires."
msgid "settings.state_db_path.label"
msgstr "Database Path"
msgid "settings.state_db_path.description"
msgstr "SQLite database holding queues, the search store, and PRIMARY scene metadata — do NOT delete or put on a network mount."
msgid "settings.db_backup_interval_hours.label"
msgstr "Database Backup Interval (Hours)"
msgid "settings.db_backup_interval_hours.description"
msgstr "Hours between database backup snapshots (0 disables); a corrupt database auto-restores from the newest good one."
msgid "settings.db_backup_keep.label"
msgstr "Database Backups to Keep"
msgid "settings.db_backup_keep.description"
msgstr "Backup snapshots to retain; older ones are pruned after each backup."
msgid "settings.db_backup_dir.label"
msgstr "Database Backup Directory"
msgid "settings.db_backup_dir.description"
msgstr "Where backup snapshots are written; blank = a \"backups\" folder next to the database (a separate disk is safest)."
msgid "settings.search_strip_actors.label"
msgstr "Strip Actor Names — Sites"
msgid "settings.search_strip_actors.description"
msgstr "Sites/studios/networks whose filenames lead with actor names — the names are dropped from the site search."
msgid "settings.disable_auto_match.label"
msgstr "Disable Automatic Matching"
msgid "settings.disable_auto_match.description"
msgstr "Suppress every match request Plex did NOT flag as user-initiated (manual=1)."

