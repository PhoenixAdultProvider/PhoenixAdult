# PhoenixAdult configuration. Installed to /var/lib/phoenixadult/.env (also read
# by the unit's EnvironmentFile). Every supported variable is listed below with
# its default. Uncomment a line to override. Relative paths (./local/...) resolve
# under the working dir (/var/lib/phoenixadult). Most options are also editable
# at runtime in the web UI (/config); see docs/configuration.md for descriptions.

# ── Server / runtime ──────────────────────────────────────────────────────────
# Run mode: leave as production for a service (no auto-reload).
NODE_ENV=production
# HTTP port (also set via Environment=PORT in the unit).
PORT=3000
# Public/base URL the provider is reached at (Cloudflare tunnel / FQDN). Used for
# metadata image links and for PEOPLE_IMAGE_URL=baseurl.
#PHOENIX_BASE_URL=
# Token protecting the config UI / admin endpoints. Set a long random value.
#ADMIN_TOKEN=
# Path to the config-UI overrides file (defaults to ./env.overrides.json in cwd).
#ENV_OVERRIDES_PATH=
# Standard outbound proxy settings (optional).
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=

# ── Logging ───────────────────────────────────────────────────────────────────
# error | warn | info | http | verbose | debug   (change needs a restart)
LOG_LEVEL=info
# Log directory (defaults to ./logs in cwd).
#LOG_DIR=
# Redact own host/FQDN + private/LAN/loopback IPs in logs (public IPs are ALWAYS
# redacted). Defaults to true under production, false otherwise.
#LOG_REDACT_HOSTS=false
# Mask secret query values (?token=, ?apikey=, ?password=) in logs.
#LOG_REDACT_TOKEN=false

# ── Images ────────────────────────────────────────────────────────────────────
#IMAGE_DIR=./local/images
# Max single upstream image fetch (e.g. 20M, 2000K, 100B).
#IMAGE_MAX_BYTES=20M

# ── Manual NFO ────────────────────────────────────────────────────────────────
#MANUAL_NFO_PATH=./local/manual
#MANUAL_NFO_TOKEN=manual

# ── People cache & sources ────────────────────────────────────────────────────
#PEOPLE_CACHE_DIR=./local/images/people
#PEOPLE_CACHE_ENABLE=true
#PEOPLE_CACHE_REPLACE_ENABLE=false
#METADATA_CACHE_ENABLE=false
#METADATA_CACHE_DIR=./local/cache
# Face-crop cached headshots (needs the "face" extra: opencv-python-headless).
#PEOPLE_CACHE_FACE_ENABLE=false
# "Scene" = the actor image from the scene page itself; remove it to skip the scene image.
#PEOPLE_SOURCE_ORDER=Local Storage,Scene,AdultDVDEmpire,Freeones,IAFD,Indexxx,Boobpedia,Babes and Stars,Babepedia
# How actor image URLs are addressed: baseurl | localhost | localipv4 | localipv6
#PEOPLE_IMAGE_URL=baseurl
#ADULT_EMPIRE_LOGIN_TOKEN=

# ── Gender handling ───────────────────────────────────────────────────────────
#GENDER_DETECT_ENABLE=true
#GENDER_SKIP_MALE_ENABLE=false
#GENERIC_IMAGE_ENABLE=true
# Override the built-in placeholder silhouettes.
#GENERIC_FEMALE_URL=
#GENERIC_MALE_URL=

# ── Web search ────────────────────────────────────────────────────────────────
#GOOGLE_SEARCH_API_KEY=
#GOOGLE_SEARCH_CX=

# ── HTTP bypass ───────────────────────────────────────────────────────────────
#FLARESOLVERR_URL=
#REQBIN_ENABLE=false
#REQBIN_API_KEY=
#BYPASS_ORDER=Impersonate,FlareSolverr,Playwright,ReqBin
#BYPASS_AUTO_RETRY=false
#BYPASS_TIMEOUT_MS=10000

# ── Data18 enrichment ─────────────────────────────────────────────────────────
#DATA18_ENABLE=false
#DATA18_ACCURACY=100
#DATA18_EXTRA=false

# ── MetadataAPI (ThePornDB) ───────────────────────────────────────────────────
#METADATAAPI_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────────
#PHOENIX_EXTRA_COLLECTIONS=false
#STRIP_ENABLE=false
#STRIP_SYMBOL=
#STRIP_SYMBOL_REVERSE=
# Whole-word junk tokens stripped from the parsed search title (built-in default shown).
#SEARCH_TITLE_TRASH=RARBG,COM,\d{3,4}x\d{3,4},HEVC,H\d{3},AVC,\dK,\d{3,4}p,TOWN.AG_,MP4,KLEENEX,SD,HD,KTR,IEVA,WRB,NBQ,ForeverAloneDude,X\d{3},SoSuMi,sexors,gush,3dh,lr,int,WEB,WEBRip,BluRay,BDRip,HDRip,DVDRip,AAC,DDP,10bit,HDR,REMUX,AV1
#DISABLE_AUTO_MATCH=false

# Primary datastore (scene metadata + queue/search state). Back up with:
#   sqlite3 state.db "VACUUM INTO 'backup.db'"
#STATE_DB_PATH=./local/state.db
